{
  "description": "The PR gate's tripwire: lc-gate hook checks the step records at the gate start and at merge (gate_pr_mode in .agents/project.yaml).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(no-mistakes axi run *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/lc-gate\" hook",
            "timeout": 90
          },
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/lc-gate\" hook",
            "timeout": 90
          },
          {
            "type": "command",
            "if": "Bash(gh -R * pr merge *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/lc-gate\" hook",
            "timeout": 90
          },
          {
            "type": "command",
            "if": "Bash(gh --repo * pr merge *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/lc-gate\" hook",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
