#!/usr/bin/env bash
# Start an agent session as a tmux window and hand it its brief.
# Usage: lc-spawn <name> <workdir> <brief-file>
# Settings come from the `sessions:` block of <workdir>'s .agents/project.yaml;
# LC_TMUX_SESSION, LC_AGENT_CMD, LC_MODEL, LC_EFFORT, LC_AGENT_FLAGS override them.
# The session gets LC_SESSION=<name>, and LC_GATE_STEP when lc-spawn is given one (lc-gate run).
# For claude, it watches the new window for up to LC_TRUST_WAIT seconds (15): Claude Code's
# folder-trust prompt is answered for a folder inside a worktree of the repository lc-spawn runs in
# (else <workdir>'s) or its handoff_dir; for any other folder it says the session waits on it.
set -euo pipefail
[[ $# -eq 3 ]] || { echo "usage: lc-spawn <name> <workdir> <brief-file>" >&2; exit 2; }
name="$1"; dir="$2"; brief="$3"
[[ -d $dir ]] || { echo "lc-spawn: no directory $dir" >&2; exit 1; }
[[ -f $brief ]] || { echo "lc-spawn: no brief $brief" >&2; exit 1; }
. "$(dirname "$(readlink -f "$0")")/lc-lib.sh"

session=${LC_TMUX_SESSION:-$(lc_conf "$dir" tmux_session agents)}
agent=${LC_AGENT_CMD:-$(lc_conf "$dir" agent_cmd claude)}
model=${LC_MODEL:-$(lc_conf "$dir" model)}
effort=${LC_EFFORT:-$(lc_conf "$dir" effort)}
flags=${LC_AGENT_FLAGS:-$(lc_conf "$dir" agent_flags)}
open_tab=${LC_OPEN_TAB:-$(lc_conf "$dir" open_tab)}
prompt="Read $brief in full and carry out that brief now."

case "$agent" in
  claude)
    cmd="claude $flags ${model:+--model $model} ${effort:+--effort $effort} -n $(printf '%q' "$name") $(printf '%q' "$prompt")" ;;
  codex)
    cmd="codex $flags ${model:+--model $model} $(printf '%q' "$prompt")" ;;
  *) echo "lc-spawn: agent_cmd must be claude or codex, not $agent" >&2; exit 1 ;;
esac
# The session knows its name, and a gate step's session its step (lc-gate record reads both).
cmd="LC_SESSION=$(printf '%q' "$name")${LC_GATE_STEP:+ LC_GATE_STEP=$(printf '%q' "$LC_GATE_STEP")} $cmd"

# The board shows the brief's title as the session's note and finds its PR from the branch.
board=$(lc_board_dir "$dir")
if [[ -d $board ]]; then printf '%s\t%s\t%s\n' "$name" "$(readlink -f "$brief")" "$(cd "$dir" && pwd)" >>"$board/spawned.tsv"; fi

if tmux has-session -t "$session" 2>/dev/null; then
  window=$(tmux new-window -d -P -F '#{window_id}' -t "$session" -n "$name" -c "$dir" "$cmd")
else
  window=$(tmux new-session -d -P -F '#{window_id}' -s "$session" -n "$name" -x 200 -y 50 -c "$dir" "$cmd")
fi

# Whether $1 is inside a worktree of the repository here (else of $1's), or that repository's handoff_dir.
trusted() {
  local d repo root
  d=$(cd "$1" && pwd -P) || return 1
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || repo=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || return 1
  while IFS= read -r root; do
    [[ -n $root ]] && root=$(cd "$root" 2>/dev/null && pwd -P) || continue
    [[ $d == "$root" || $d == "$root"/* ]] && return 0
  done < <(git -C "$repo" worktree list --porcelain | sed -n 's/^worktree //p'; lc_get "$repo" handoff_dir; echo)
  return 1
}

if [[ $agent == claude ]]; then
  last=""; same=0
  for ((i = 0; i < ${LC_TRUST_WAIT:-15} * 4; i++)); do
    pane=$(tmux capture-pane -p -t "$window" 2>/dev/null) || break
    if grep -Eqi 'trust (this|the files in this) folder|do you trust' <<<"$pane"; then
      if trusted "$dir"; then
        tmux send-keys -t "$window" Enter
        echo "lc-spawn: answered Claude Code's folder-trust prompt for $dir"
      else
        echo "lc-spawn: $name is waiting on Claude Code's folder-trust prompt for $dir, which is outside this repository's worktrees and handoff_dir: answer it in tmux window $session:$name"
      fi
      break
    fi
    # Settled without asking: the same text for a second.
    if [[ -n ${pane//[[:space:]]/} && $pane == "$last" ]]; then
      same=$((same + 1))
      if ((same >= 4)); then break; fi
    else
      same=0
    fi
    last=$pane
    sleep 0.25
  done
fi
if [[ -n $open_tab ]]; then bash -c "$open_tab" _ "$name" || true; fi
echo "spawned $name in tmux session $session"
