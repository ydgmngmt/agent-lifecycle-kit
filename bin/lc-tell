#!/usr/bin/env bash
# Tell a session one line. It is appended to <handoff_dir>/tell.log (time, sender, receiver, line; else
# .agents/tell.log) and typed into the receiver's tmux window as a message. `lead` is the session
# named in sessions.lead. The sender is LC_SESSION, else sessions.lead, else "lead".
# Usage: lc-tell <session|lead> "<line>"   (tmux session: LC_TMUX_SESSION, else the project file of $PWD)
set -uo pipefail
[[ $# -eq 2 && -n $2 ]] || { echo 'usage: lc-tell <session|lead> "<line>"' >&2; exit 2; }
. "$(dirname "$(readlink -f "$0")")/lc-lib.sh"
to=$1
line=${2//$'\n'/ }
lead=$(lc_conf "$PWD" lead)
if [[ $to == lead ]]; then
  to=$lead
  [[ -n $to ]] || { echo "lc-tell: no sessions.lead in .agents/project.yaml: name the lead's tmux window there" >&2; exit 1; }
fi
from=${LC_SESSION:-${lead:-lead}}
session=${LC_TMUX_SESSION:-$(lc_conf "$PWD" tmux_session agents)}
root=$(timeout 10 git rev-parse --show-toplevel 2>/dev/null || pwd)
handoff=$(lc_get "$root" handoff_dir)
dir=${handoff:-$root/.agents}
mkdir -p "$dir"
# Every tell is logged with how it went: told, or refused and why (the sender is told too, exit 1;
# the board tries a refused one again).
logged() { printf '%s\t%s\t%s\t%s\t%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$from" "$to" "$line" "$1" >>"$dir/tell.log"; }
refuse() { logged "refused: $1"; echo "lc-tell: $1; the line is kept in $dir/tell.log" >&2; exit 1; }
# The window by its exact name, addressed by its id: a name with a dot would read as a pane.
id=$(timeout 10 tmux list-windows -t "$session" -F $'#{window_id}\t#W' 2>/dev/null | awk -F'\t' -v w="$to" '$2 == w { print $1; exit }')
[[ -n $id ]] || refuse "no window $to in tmux session $session"
# One tell at a time per directory, and none over text someone left unsent in the input line: the last
# line with ❯, read with its colours, less the dim text Claude Code draws there itself (a placeholder
# or a suggested prompt), which Enter would not send.
exec 9>>"$dir/tell.lock"
flock -w 30 9 || refuse "another lc-tell held $dir/tell.lock for 30s"
input=$(timeout 10 tmux capture-pane -p -e -t "$id" 2>/dev/null | grep -a '❯' | tail -n 1 |
  sed -E $'s/\x1b\\[2m[^\x1b]*(\x1b\\[(0|22)m)?//g; s/\x1b\\[[0-9;]*m//g; s/\xc2\xa0/ /g; s/^.*❯//')
[[ -z ${input//[[:space:]]/} ]] || refuse "$to has unsent text in its input line (${input# })"
# Typed, then Enter a moment later, so the agent takes it as one message.
timeout 10 tmux send-keys -t "$id" -l "from $from: $line" && sleep 0.3 && timeout 10 tmux send-keys -t "$id" Enter || refuse "tmux could not type into $session:$to"
logged told
echo "told $to"
