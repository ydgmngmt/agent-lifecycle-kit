#!/usr/bin/env bash
# Every acceptance criterion has a flow script: exit 1 listing each criterion id of the acceptance
# file (`<stage>-AC<n>`, first column of its tables) that no file under the given folders names.
# Usage: lc-criteria <acceptance file> <flow script folder>...
set -euo pipefail
[[ $# -ge 2 && -f $1 ]] || { echo "usage: lc-criteria <acceptance file> <flow script folder>..." >&2; exit 2; }
file=$1; shift
ids=$(grep -oE '^\| *[A-Za-z0-9_.-]+-AC[0-9]+ *\|' "$file" | tr -d '| ' | sort -u || true)
[[ -n $ids ]] || { echo "lc-criteria: no criterion id (<stage>-AC<n>) in the tables of $file" >&2; exit 1; }
missing=0
while read -r id; do
  if ! grep -rqwF -- "$id" "$@" 2>/dev/null; then echo "no flow script names $id"; missing=1; fi
done <<<"$ids"
[[ $missing -eq 0 ]] && echo "every criterion of $file has a flow script ($(wc -l <<<"$ids" | tr -d ' '))"
exit $missing
