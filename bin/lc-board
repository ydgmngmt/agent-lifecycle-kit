#!/usr/bin/env bash
# The ADLC board for the repository in the current directory (board/server.mjs, board/cli.mjs).
#   lc-board start|stop|status [repo dir]   the server; start does nothing when it already runs
#   lc-board keeper                         start the board-keeper session (board.keeper_model)
#   lc-board set|item|journey|criterion|session|ask|outcome|answers|stale|log …
#                                           one-line updates and reads; see board/cli.mjs
# Port and data dir come from .agents/project.yaml (board.port, board.data_dir, else
# <handoff_dir>/board); LC_BOARD_PORT and LC_BOARD_DIR override them.
set -euo pipefail
cmd=${1:-status}
case "$cmd" in start|stop|status|keeper) dir=$(cd "${2:-.}" && pwd) ;; *) dir=$PWD ;; esac
. "$(dirname "$(readlink -f "$0")")/lc-lib.sh"
kit=$(dirname "$(dirname "$(readlink -f "$0")")")
root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || echo "$dir")
port=${LC_BOARD_PORT:-$(lc_get "$root" board.port 4777)}
data=$(lc_board_dir "$root")
pidfile=$data/server.pid
running() { [[ -f $pidfile ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }

case "$cmd" in
  start)
    if running; then echo "board already running (pid $(cat "$pidfile")) on http://localhost:$port"; exit 0; fi
    mkdir -p "$data"
    [[ -f $data/state.json ]] || echo '{"headline": "", "phases": {}, "sessions": {}}' >"$data/state.json"
    [[ -f $data/questions.json ]] || echo '[]' >"$data/questions.json"
    touch "$data/answers.jsonl"
    LC_BOARD_PORT=$port LC_BOARD_DIR=$data nohup node "$kit/board/server.mjs" "$root" >"$data/server.log" 2>&1 &
    echo $! >"$pidfile"
    sleep 1
    running || { echo "board failed to start:" >&2; tail -5 "$data/server.log" >&2; exit 1; }
    echo "board on http://localhost:$port (data $data)" ;;
  stop)
    if running; then kill "$(cat "$pidfile")"; rm -f "$pidfile"; echo stopped; else echo "board not running"; fi ;;
  status)
    if running; then echo "running (pid $(cat "$pidfile")) on http://localhost:$port, data $data"; else echo "not running; data $data"; exit 1; fi ;;
  keeper)
    brief=$data/keeper-brief.md
    printf '# Board keeper for %s\n\nInvoke the `board-keeper` skill and follow it. Repository: %s. Wait for the word `tick`.\n' "$(basename "$root")" "$root" >"$brief"
    # A small context: no MCP servers, no user or project settings, only this kit's skills.
    # Measured on one repository: 44k tokens of fixed context per call by default, 26k this way.
    # Without user settings, Claude Code asks again to accept bypass mode; --settings answers that.
    flags="$(lc_conf "$root" agent_flags) $(lc_get "$root" board.keeper_flags "--strict-mcp-config --setting-sources '' --settings '{\"skipDangerousModePermissionPrompt\":true}' --plugin-dir $kit")"
    LC_AGENT_FLAGS=${LC_AGENT_FLAGS:-$flags} LC_MODEL=${LC_MODEL:-$(lc_get "$root" board.keeper_model)} LC_EFFORT=${LC_EFFORT:-$(lc_get "$root" board.keeper_effort)} \
      exec "$(dirname "$(readlink -f "$0")")/lc-spawn" board-keeper "$root" "$brief" ;;
  *) LC_BOARD_PORT=$port LC_BOARD_DIR=$data exec node "$kit/board/cli.mjs" "$root" "$@" ;;
esac
