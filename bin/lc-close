#!/usr/bin/env bash
# Close finished agent sessions: their tmux windows and any lc-view sessions on them. Each window is
# found by its exact name and closed by its id (a name with a dot would read as a pane), and the name is
# noted with the time in the board's closed.tsv, so lc-gate run does not start a closed gate session again.
# Usage: lc-close <name> [<name> ...]   (tmux session: LC_TMUX_SESSION, else the project file of $PWD)
set -uo pipefail
[[ $# -ge 1 ]] || { echo "usage: lc-close <name> [<name> ...]" >&2; exit 2; }
. "$(dirname "$(readlink -f "$0")")/lc-lib.sh"
session=${LC_TMUX_SESSION:-$(lc_conf "$PWD" tmux_session agents)}
board=$(lc_board_dir "$PWD")
for w in "$@"; do
  for id in $(timeout 10 tmux list-windows -t "$session" -F $'#{window_id}\t#W' 2>/dev/null | awk -F'\t' -v w="$w" '$2 == w { print $1 }'); do
    timeout 10 tmux kill-window -t "$id" 2>/dev/null
  done
  timeout 10 tmux kill-session -t "view-$w" 2>/dev/null
  if [[ -d $board ]]; then printf '%s\t%s\n' "$w" "$(date +%s)" >>"$board/closed.tsv"; fi
  echo "closed $w"
done
